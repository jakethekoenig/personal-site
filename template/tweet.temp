<!DOCTYPE html>
<html lang="en">
<:comp/header:>
<style>
<:css/tweets.css:>

.tweet-content img {
    max-width: 100%;
    height: auto;
}
</style>
<body>
	<main>
	<:comp/sidemenu:>
	<div class="main_content">
                <div style="height: 50px;"></div>
		<div class="individual-tweet" style="margin-left: 20px;">
			<div class="tweet-header">
				<span class="tweet-date"><$Date$></span>
				<div class="tweet-links">
					<a href="<$tweet_url$>" target="_blank" class="tweet-twitter-link" title="View original post on <$source_name$>">
						<$source_badge$>
					</a>
				</div>
			</div>
			<div class="tweet-content">
				<[Content]>
			</div>
		</div>
		
		<div class="comments-section">
			<div class="comments">
				<div>
					<textarea class="comment_box" placeholder="comment" id="comment" name="comment" rows="3"></textarea><br>
					<input type="text" class="author_box" placeholder="name" id="username" name="username" rows="1"/><br>
					<button class="submit_button" type="submit" value="Submit" data-comment-dir="<$comment_path$>">Submit</button>
				</div>
				<br>
				<[Comments]>
				<script src="/js/comment.js"></script>
			</div>
		</div>
	</div>
	</main>
	<br>
	<div id="socials_footer">
	<:comp/socials:>
	</div>
</body>
</html>
